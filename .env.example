# Copy this file to .env and adjust values.
# Do not commit .env (it is gitignored).

# Public URL of your Moodle instance
MOODLE_WWWROOT=http://localhost:8080

# Database connection (matches docker-compose defaults)
MOODLE_DBTYPE=mysqli
MOODLE_DBHOST=db
MOODLE_DBNAME=moodle
MOODLE_DBUSER=moodle
MOODLE_DBPASSWORD=moodle

# Redis (optional but enabled by default in this stack)
MOODLE_REDIS_HOST=redis

# Reverse proxy settings (set to 1/true when behind a proxy / TLS terminator)
MOODLE_REVERSEPROXY=0
MOODLE_SSLPROXY=0
MOODLE_ROUTERCONFIGURED=0

# One-shot actions
# MOODLE_RUN_INSTALL=1
# MOODLE_RUN_UPGRADE=1

# Install-time settings (only used when MOODLE_RUN_INSTALL=1)
MOODLE_SITE_FULLNAME=moodle
MOODLE_SITE_SHORTNAME=moodle
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=change-me
MOODLE_ADMIN_EMAIL=admin@example.com

# Plugin/theme sources baked into the images (optional overrides)
MOODLE_THEME_ADAPTABLE_ZIP_URL=https://moodle.org/plugins/download.php/27987/theme_adaptable_moodle311_2021081009.zip
MOODLE_LOCAL_PROFILECOHORT_ZIP_URL=https://moodle.org/plugins/download.php/27301/local_profilecohort_moodle311_2021061303.zip
MOODLE_LOCAL_CNW_SMARTCOHORT_ZIP_URL=https://moodle.org/plugins/download.php/19488/local_cnw_smartcohort_moodle39_2019050603.zip
MOODLE_BLOCK_COURSEFEEDBACK_ZIP_URL=https://github.com/Moodle-Course-Evaluations-MCE/moodle-block_coursefeedback/archive/refs/tags/v3.1.2.zip
